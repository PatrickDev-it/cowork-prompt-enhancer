{
  "name": "cowork-prompt-enhancer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": "1.3.12",
    "node": "22.13.0"
  },
  "scripts": {
    "install:frozen": "bun install --frozen-lockfile && python -m pip install --require-hashes -r server/modules/requirements-dev.lock",
    "format": "biome format --write . && ruff format server/modules/prompt_enhancer",
    "format:check": "biome format . && ruff format --check server/modules/prompt_enhancer",
    "lint": "biome lint . && ruff check server/modules/prompt_enhancer",
    "typecheck": "bun run --workspaces --sequential typecheck",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test server client && python -m pytest server/modules/prompt_enhancer",
    "test:integration": "bun test tests/integration",
    "audit": "bun audit && python -m pip_audit -r server/modules/requirements-dev.lock",
    "preflight": "bun run scripts/preflight.ts",
    "demo:mock": "bun run scripts/mock-demo.ts",
    "benchmark": "python evaluation/benchmark.py",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4"
  }
}
