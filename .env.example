# Named provider profile: mock (offline default), local, or openai-compatible.
COWORK_PROFILE=mock

# Deterministic mock failure injection: success, malformed, context_overflow, timeout, provider_failure.
COWORK_MOCK_SCENARIO=success

# Local profile. Paths are intentionally examples; binaries and models are never committed.
COWORK_LLAMA_SERVER_BIN=server/bin/llama-server.exe
COWORK_PROMPT_MODEL=server/models/Qwen3-8B-Q4_K_M.gguf
COWORK_LLAMA_SERVER_URL=http://127.0.0.1:8081

# OpenAI-compatible profile. Leave credential empty and provide it only in the process environment.
COWORK_OPENAI_BASE_URL=https://compatible-endpoint.example
COWORK_OPENAI_MODEL=
COWORK_OPENAI_API_KEY=
COWORK_PROVIDER_TIMEOUT_S=600
